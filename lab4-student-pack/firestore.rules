rules_version = '2';

// Lab 3.3 · Security Rules ของบ้านบรู
// หลักคิด: ปฏิเสธทุกอย่างเป็นค่าเริ่มต้น แล้วเปิดเฉพาะที่จำเป็น
// deploy: npx firebase-tools deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // เมนูและสาขา: อ่านได้เมื่อล็อกอิน แก้ไขได้เฉพาะ admin script (firebase-admin ข้าม rules)
    match /products/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /branches/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ยอดขาย: อ่านได้เมื่อล็อกอิน · เพิ่มได้ถ้าข้อมูลถูกต้องทุกข้อ · แก้/ลบไม่ได้จากหน้าเว็บ
    match /sales/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && validSale(request.resource.data);
      allow update, delete: if false;
    }

    function validSale(d) {
      let product = get(/databases/$(database)/documents/products/$(d.product_id)).data;
      return d.keys().hasOnly(['order_id', 'datetime', 'date', 'hour', 'branch', 'product_id', 'qty',
                               'unit_price', 'revenue', 'customer_id', 'payment_method', 'channel',
                               'source', 'created_by', 'created_at'])
        && d.keys().hasAll(['order_id', 'datetime', 'date', 'hour', 'branch', 'product_id', 'qty',
                            'unit_price', 'revenue', 'payment_method', 'channel', 'source',
                            'created_by', 'created_at'])
        && d.source == 'web'
        && d.created_by == request.auth.uid                         // ปลอมตัวเป็นคนอื่นไม่ได้
        && d.created_at == request.time                             // ต้องใช้เวลาของเซิร์ฟเวอร์
        && d.branch in ['สยาม', 'สีลม', 'อารีย์', 'บางนา', 'มหาวิทยาลัย']
        && d.qty is int && d.qty >= 1 && d.qty <= 20
        && d.unit_price == product.price                            // ราคาต้องตรงกับเมนูจริง
        && d.revenue == d.qty * d.unit_price
        && d.date is string && d.date.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$')
        && d.datetime is string && d.datetime.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+]07:00$')
        && d.hour is int && d.hour >= 0 && d.hour <= 23
        && (d.get('customer_id', null) == null || d.customer_id.matches('^C[0-9]{5}$'))
        && d.payment_method in ['QR พร้อมเพย์', 'บัตรเครดิต', 'เงินสด', 'LINE MAN', 'Grab'];
    }
  }
}
